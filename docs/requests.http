@baseUrl = http://localhost:8080

### Health
GET {{baseUrl}}/actuator/health

### Dictionary
GET {{baseUrl}}/api/v1/graph/dictionary

### Node summary before expand
GET {{baseUrl}}/api/v1/graph/node-summary?nodeId=N_PARTY_1001

### Node summary for filtered expand preview
GET {{baseUrl}}/api/v1/graph/node-summary?nodeId=N_PARTY_1001&relationFamily=CUSTOMER_OWNERSHIP&direction=OUTBOUND

### Search nodes for manual anchor seed
GET {{baseUrl}}/api/v1/graph/nodes/search?query=Alice&nodeType=PERSON&limit=10&includeAttributes=true

### Start investigation from SQL seed query
POST {{baseUrl}}/api/v1/graph/query
Content-Type: application/json

{
  "sql": "select node_id from g_nodes where node_id = 'N_PARTY_1001'",
  "resultMode": "SEEDS",
  "relationFamily": "CUSTOMER_OWNERSHIP",
  "direction": "OUTBOUND",
  "maxNeighborsPerSeed": 10,
  "maxNodes": 100,
  "maxEdges": 100,
  "includeAttributes": true
}

### Return graph slice from SQL edge query
POST {{baseUrl}}/api/v1/graph/query
Content-Type: application/json

{
  "sql": "select edge_id from g_edges where edge_id = 'E_OWNS_1001_2001'",
  "resultMode": "GRAPH",
  "maxNodes": 100,
  "maxEdges": 100,
  "includeAttributes": true
}

### Import CSV preview
POST {{baseUrl}}/api/v1/graph/import/preview
Content-Type: multipart/form-data; boundary=graph-import

--graph-import
Content-Disposition: form-data; name="file"; filename="graph-import.csv"
Content-Type: text/csv

record_type,node_id,node_type,display_name,party_rk,account_no,from_node_id,to_node_id,edge_id,edge_type,relation_family,directed
NODE,N_IMPORT_1,PERSON,Imported Customer,PARTY_IMPORT_1,,,,,,,
NODE,N_IMPORT_2,ACCOUNT,Imported Account,,40817810000000999999,,,,,,
EDGE,,,,,,N_IMPORT_1,N_IMPORT_2,E_IMPORT_1,OWNS,CUSTOMER_OWNERSHIP,true
--graph-import--

### Import CSV commit
POST {{baseUrl}}/api/v1/graph/import/commit
Content-Type: multipart/form-data; boundary=graph-import

--graph-import
Content-Disposition: form-data; name="file"; filename="graph-import.csv"
Content-Type: text/csv

record_type,node_id,node_type,display_name,party_rk,account_no,from_node_id,to_node_id,edge_id,edge_type,relation_family,directed
NODE,N_IMPORT_1,PERSON,Imported Customer,PARTY_IMPORT_1,,,,,,,
NODE,N_IMPORT_2,ACCOUNT,Imported Account,,40817810000000999999,,,,,,
EDGE,,,,,,N_IMPORT_1,N_IMPORT_2,E_IMPORT_1,OWNS,CUSTOMER_OWNERSHIP,true
--graph-import--

### Expand (1-hop)
POST {{baseUrl}}/api/v1/graph/expand
Content-Type: application/json

{
  "seeds": [
    {"type": "PARTY_RK", "value": "PARTY_1002"}
  ],
  "relationFamily": "PERSON_KNOWS_PERSON",
  "direction": "OUTBOUND",
  "maxNeighborsPerSeed": 1,
  "maxNodes": 100,
  "maxEdges": 100,
  "includeAttributes": true
}

### Shortest path
POST {{baseUrl}}/api/v1/graph/shortest-path
Content-Type: application/json

{
  "source": {"type": "PARTY_RK", "value": "PARTY_1001"},
  "target": {"type": "PARTY_RK", "value": "PARTY_1003"},
  "relationFamily": "PERSON_KNOWS_PERSON",
  "direction": "OUTBOUND",
  "maxDepth": 4
}

### Expand by account seed
POST {{baseUrl}}/api/v1/graph/expand
Content-Type: application/json

{
  "seeds": [
    {"type": "ACCOUNT_NO", "value": "40817810000000002001"}
  ],
  "relationFamily": "ACCOUNT_FLOW",
  "direction": "OUTBOUND",
  "maxNeighborsPerSeed": 10,
  "maxNodes": 100,
  "maxEdges": 100,
  "includeAttributes": true
}

### Shortest path to company by tax id
POST {{baseUrl}}/api/v1/graph/shortest-path
Content-Type: application/json

{
  "source": {"type": "PARTY_RK", "value": "PARTY_1001"},
  "target": {"type": "TAX_ID", "value": "7701234567"},
  "relationFamily": "CORPORATE_CONTROL",
  "direction": "OUTBOUND",
  "maxDepth": 2
}

### Export JSON
POST {{baseUrl}}/api/v1/graph/export?format=JSON
Content-Type: application/json

{
  "nodes": [
    {"nodeId":"N1","displayName":"Node 1","identifiers":{"party_rk":"PARTY_1"},"statuses":["VIP"],"attributes":{"a":1}}
  ],
  "edges": [
    {"edgeId":"E1","fromNodeId":"N1","toNodeId":"N2","type":"KNOWS","directed":true,"weight":10.5,"attributes":{"confidence":0.9}}
  ]
}

### Export CSV
POST {{baseUrl}}/api/v1/graph/export?format=CSV
Content-Type: application/json

{
  "nodes": [
    {"nodeId":"N1","displayName":"Node 1"}
  ],
  "edges": []
}

### Export NDJSON
POST {{baseUrl}}/api/v1/graph/export?format=NDJSON
Content-Type: application/json

{
  "nodes": [
    {"nodeId":"N1","displayName":"Node 1"}
  ],
  "edges": []
}
